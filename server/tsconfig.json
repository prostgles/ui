{
	"files": ["./src/index.ts", "./src/testElectron.ts"],
	"compilerOptions": {
		"outDir": "dist",
		"target": "ES2022",
		"lib": [ "ES2017", "es2019", "ES2021.String", "ES2023" ],
		"esModuleInterop" : true,
		"resolveJsonModule": true,
		"allowSyntheticDefaultImports": true,
		"allowJs": true,
		"module": "commonjs",
		"sourceMap": true,
		"moduleResolution": "node",
		"declaration": true,
		"declarationMap": true,
		"ignoreDeprecations": "5.0",
		"strict": true,
		"skipLibCheck": true,
		"strictFunctionTypes": true,
		"noImplicitAny": true,
		"noUncheckedIndexedAccess": true,
		"baseUrl": ".",
		"importHelpers":true,
		"noEmitHelpers": true,
		"paths": {
			"@common/*": [
				"../common/*"
			],
			"@src/*": [
				"src/*"
			],
		}
	},
	"exclude": [
		"dist",
		"DBoGenerated.ts",
		"*.conf",
		"prostgles_mcp",
		"src/ServiceManager/services/**/src",
	],
	"include": [
		"src",
		"**/*.spec.ts"
, "../common/getJsonSchemaAsTs.ts", "../common/startAgenticWorkflowSchema.ts"	]
}